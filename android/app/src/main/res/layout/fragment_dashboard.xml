<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="لوحة التحكم"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مرحباً — إليك ملخص أداءك اليوم"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Stats Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="عمولة الشهر" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:textAllCaps="true" android:letterSpacing="0.05" android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_commission"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 ج.م" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/gold"/>
                    <TextView android:id="@+id/tv_comm_growth"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="+0%" android:textSize="11sp" android:textColor="@color/emerald"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="صفقات الشهر" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:textAllCaps="true" android:letterSpacing="0.05" android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_deals"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/emerald"/>
                    <TextView android:id="@+id/tv_deals_goal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="الهدف: —" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="الليدز النشطة" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:textAllCaps="true" android:letterSpacing="0.05" android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_leads"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/sky"/>
                    <TextView android:id="@+id/tv_new_leads"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="جديد اليوم: 0" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="مهام متأخرة" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:textAllCaps="true" android:letterSpacing="0.05" android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_overdue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/rose"/>
                    <TextView android:id="@+id/tv_pending"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="معلقة: 0" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>

        <!-- Goals Mini -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎯 أهداف الشهر" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
                <!-- Deals goal -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الصفقات"
                        android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/tv_goal_deals_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/emerald"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_goal_deals"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:max="100" android:progress="0" android:layout_marginBottom="10dp"
                    android:progressTint="@color/emerald"/>
                <!-- Comm goal -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="العمولة"
                        android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/tv_goal_comm_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/gold"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_goal_comm"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:max="100" android:progress="0" android:layout_marginBottom="10dp"
                    android:progressTint="@color/gold"/>
                <!-- Leads goal -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الليدز"
                        android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/tv_goal_leads_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/sky"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_goal_leads"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:max="100" android:progress="0"
                    android:progressTint="@color/sky"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hot Leads -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔥 الليدز الساخنة"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hot_leads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
                <TextView android:id="@+id/tv_no_hot_leads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="لا توجد ليدز ساخنة حالياً"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Upcoming Tasks -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📅 المهام القادمة"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_upcoming_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
                <TextView android:id="@+id/tv_no_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="لا مهام قادمة 🎉"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recent Activity -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚡ آخر النشاطات"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_activities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
