<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome — Here is your performance summary"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Stats Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Monthly Commission" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_commission"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 EGP" android:textSize="20sp" android:textStyle="bold"
                        android:textColor="@color/gold"/>
                    <TextView android:id="@+id/tv_comm_growth"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="+0%" android:textSize="11sp" android:textColor="@color/emerald"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Monthly Deals" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_deals"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/emerald"/>
                    <TextView android:id="@+id/tv_deals_goal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Target: —" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Active Leads" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_leads"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/sky"/>
                    <TextView android:id="@+id/tv_new_leads"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="New today: 0" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Overdue Tasks" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_overdue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/rose"/>
                    <TextView android:id="@+id/tv_pending"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pending: 0" android:textSize="11sp" android:textColor="@color/text_tertiary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>

        <!-- Mini Goals -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📊 Monthly Goals"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <!-- Goal Deals -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🤝 Deals" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/tv_goal_deals_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_goal_deals"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp"
                    android:progressDrawable="@drawable/progress_gold"
                    android:max="100" android:progress="0" android:layout_marginBottom="12dp"/>

                <!-- Goal Commission -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="💰 Commission" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/tv_goal_comm_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_goal_comm"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp"
                    android:progressDrawable="@drawable/progress_emerald"
                    android:max="100" android:progress="0" android:layout_marginBottom="12dp"/>

                <!-- Goal Leads -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="👥 Leads" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/tv_goal_leads_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_goal_leads"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp"
                    android:progressDrawable="@drawable/progress_sky"
                    android:max="100" android:progress="0"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hot Leads -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔥 Hot Leads"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hot_leads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
                <TextView android:id="@+id/tv_no_hot_leads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hot leads yet 🔥"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Upcoming Tasks -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📅 Upcoming Tasks"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_upcoming_tasks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView android:id="@+id/tv_no_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No upcoming tasks 🎉"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recent Activity -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚡ Recent Activity"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_activities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
