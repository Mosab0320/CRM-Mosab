<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأهداف والأداء"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <!-- Monthly Goals Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎯 أهداف الشهر" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Commission Goal -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="💰 العمولة الشهرية"
                                android:textSize="13sp" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/tv_comm_m_pct"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0%" android:textSize="15sp"
                                android:textStyle="bold" android:textColor="@color/gold"/>
                        </LinearLayout>
                        <ProgressBar android:id="@+id/pb_comm_m"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="6dp"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/gold"/>
                        <TextView android:id="@+id/tv_comm_m_detail"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 / 0 ج.م" android:textSize="11sp"
                            android:textColor="@color/text_tertiary" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Deals Goal -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="🤝 الصفقات الشهرية"
                                android:textSize="13sp" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/tv_deals_m_pct"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0%" android:textSize="15sp"
                                android:textStyle="bold" android:textColor="@color/emerald"/>
                        </LinearLayout>
                        <ProgressBar android:id="@+id/pb_deals_m"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="6dp"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/emerald"/>
                        <TextView android:id="@+id/tv_deals_m_detail"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 / 0 صفقة" android:textSize="11sp"
                            android:textColor="@color/text_tertiary" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Leads Goal -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="👥 الليدز الشهرية"
                                android:textSize="13sp" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/tv_leads_m_pct"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0%" android:textSize="15sp"
                                android:textStyle="bold" android:textColor="@color/sky"/>
                        </LinearLayout>
                        <ProgressBar android:id="@+id/pb_leads_m"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="6dp"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/sky"/>
                        <TextView android:id="@+id/tv_leads_m_detail"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 / 0 ليد" android:textSize="11sp"
                            android:textColor="@color/text_tertiary" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Annual Goals -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📆 الأهداف السنوية" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="💰 العمولة السنوية"
                            android:textSize="13sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_comm_y_pct"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0%" android:textSize="15sp"
                            android:textStyle="bold" android:textColor="@color/violet"/>
                    </LinearLayout>
                    <ProgressBar android:id="@+id/pb_comm_y"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="6dp"
                        android:max="100" android:progress="0"
                        android:progressTint="@color/violet"/>
                    <TextView android:id="@+id/tv_comm_y_detail"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 / 0 ج.م" android:textSize="11sp"
                        android:textColor="@color/text_tertiary" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="🤝 الصفقات السنوية"
                            android:textSize="13sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_deals_y_pct"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0%" android:textSize="15sp"
                            android:textStyle="bold" android:textColor="@color/amber"/>
                    </LinearLayout>
                    <ProgressBar android:id="@+id/pb_deals_y"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="6dp"
                        android:max="100" android:progress="0"
                        android:progressTint="@color/amber"/>
                    <TextView android:id="@+id/tv_deals_y_detail"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 / 0 صفقة" android:textSize="11sp"
                        android:textColor="@color/text_tertiary" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
