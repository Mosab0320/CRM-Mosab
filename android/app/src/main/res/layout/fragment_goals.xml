<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goals"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <!-- Monthly Commission -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="💰 عمولة الشهر" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/tv_comm_m_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_comm_m"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_emerald"
                    android:max="100" android:progress="0" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_comm_m_detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 / 0 ج.م" android:textSize="12sp" android:textColor="@color/text_tertiary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Monthly Deals -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🤝 صفقات الشهر" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/tv_deals_m_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_deals_m"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_gold"
                    android:max="100" android:progress="0" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_deals_m_detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 / 0 صفقة" android:textSize="12sp" android:textColor="@color/text_tertiary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Monthly Leads -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="👥 ليدز الشهر" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/tv_leads_m_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_leads_m"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_sky"
                    android:max="100" android:progress="0" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_leads_m_detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 / 0 ليد" android:textSize="12sp" android:textColor="@color/text_tertiary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Yearly Commission -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="💰 عمولة السنة" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/tv_comm_y_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_comm_y"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_emerald"
                    android:max="100" android:progress="0" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_comm_y_detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 / 0 ج.م" android:textSize="12sp" android:textColor="@color/text_tertiary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Yearly Deals -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🤝 صفقات السنة" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/tv_deals_y_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/rose"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_deals_y"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_gold"
                    android:max="100" android:progress="0" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_deals_y_detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 / 0 صفقة" android:textSize="12sp" android:textColor="@color/text_tertiary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
